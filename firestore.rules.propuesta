rules_version = '2';
// ─────────────────────────────────────────────────────────────────────────────
// REGLAS PROPUESTAS — NO DESPLEGADAS.
// Basadas en firestore.rules (actual). Cambios: colección `ventas` (nueva),
// validación de `cupones` (códigos promocionales) y lectura de cupones sin listado.
// Para publicarlas: revisar, copiar a firestore.rules y ejecutar `firebase deploy --only firestore:rules`.
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuario autenticado con rol de empleado o admin (claim o documento users/{uid})
    function isEmpleado() {
      return request.auth != null && (
        request.auth.token.role == 'employee' ||
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['employee', 'admin'])
      );
    }

    // 1. Productos (sin cambios)
    match /productos/{productoId} {
      allow read: if true;
      allow create, delete: if isEmpleado();
      allow update: if isEmpleado() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
        request.resource.data.stock >= 0 &&
        request.resource.data.stock < resource.data.stock
      );
    }

    // 2. Códigos promocionales
    match /cupones/{codigo} {

      // Datos válidos de un código (lo que guarda el panel de empleados)
      function codigoValido(d) {
        return d.codigo == codigo &&
          codigo.matches('^[A-Z0-9_-]{3,20}$') &&
          d.tipo in ['porcentaje', 'monto_fijo'] &&
          d.valor is int && d.valor > 0 &&
          (d.tipo != 'porcentaje' || d.valor <= 100) &&
          d.vigenciaHasta is timestamp &&
          (d.get('fechaInicio', null) == null || d.fechaInicio is timestamp) &&
          (d.get('usosMaximos', null) == null || (d.usosMaximos is int && d.usosMaximos > 0)) &&
          d.get('compraMinima', 0) is int && d.get('compraMinima', 0) >= 0 &&
          d.get('activo', true) is bool &&
          d.get('aplicaA', 'todo') in ['todo', 'categorias', 'modelos'];
      }

      // Un cliente solo puede "gastar" un uso de un código usable en este momento
      function usoValido() {
        return resource.data.get('activo', true) == true &&
          request.time < resource.data.vigenciaHasta &&
          (resource.data.get('fechaInicio', null) == null || request.time >= resource.data.fechaInicio) &&
          (resource.data.get('usosMaximos', null) == null ||
            resource.data.usosActuales < resource.data.usosMaximos) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usosActuales']) &&
          request.resource.data.usosActuales == resource.data.usosActuales + 1;
      }

      // Leer UN código conocido (para validarlo en el carrito), pero no listar todos
      allow get: if true;
      allow list: if isEmpleado();

      allow create: if isEmpleado() && codigoValido(request.resource.data) &&
        request.resource.data.usosActuales == 0;
      allow update: if (isEmpleado() && codigoValido(request.resource.data) &&
                        request.resource.data.usosActuales == resource.data.usosActuales) ||
                       usoValido();
      allow delete: if isEmpleado();
    }

    // 3. Preguntas frecuentes (sin cambios)
    match /faq/{faqId} {
      allow read: if true;
      allow write: if isEmpleado();
    }

    // 4. Usuarios y roles (sin cambios)
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isEmpleado());
      allow write: if isEmpleado();
    }

    // 5. Pedidos (sin cambios; la app hoy no la usa)
    match /pedidos/{pedidoId} {
      allow create: if true;
      allow read, update, delete: if isEmpleado();
    }

    // 6. Ventas (NUEVA): la crea el checkout al confirmar un pedido; solo empleados la leen
    match /ventas/{ventaId} {
      function itemValido(i) {
        return i.keys().hasOnly(['productoId', 'nombre', 'modelo', 'categoria', 'cantidad', 'precio']) &&
          i.cantidad is int && i.cantidad > 0 && i.precio is int && i.precio >= 0;
      }

      allow create: if
        request.resource.data.keys().hasOnly(
          ['fecha', 'items', 'subtotal', 'descuento', 'total', 'codigoPromocional', 'cliente', 'formaPago']) &&
        request.resource.data.fecha == request.time &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50 &&
        itemValido(request.resource.data.items[0]) &&
        request.resource.data.subtotal is int && request.resource.data.subtotal >= 0 &&
        request.resource.data.descuento is int && request.resource.data.descuento >= 0 &&
        request.resource.data.total is int &&
        request.resource.data.total == request.resource.data.subtotal - request.resource.data.descuento &&
        request.resource.data.formaPago in ['efectivo', 'transferencia'];
      allow read, update, delete: if isEmpleado();
    }
  }
}
